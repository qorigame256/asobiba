{
  "root": "../..",
  "mode": "copy",
  "copy": [
    "app/js",
    "app/fonts",
    "app/voice",
    "app/sounds",
    "tools/test-logic.mjs",
    "tools/font-chars.json",
    "tools/font-texts.mjs",
    "tools/voice-texts.mjs"
  ],
  "cwd": "copy",
  "env": {
    "QUICK": "1",
    "SEED": "1"
  },
  "build": [
    "node",
    "--input-type=module",
    "-e",
    "await import('./app/js/games/index.js')"
  ],
  "test": [
    "node",
    "tools/test-logic.mjs"
  ],
  "failPattern": "AssertionError \\[ERR_ASSERTION\\]: (.*)",
  "timeoutSec": 300,
  "breaks": [
    {
      "name": "ひよこ: 1色だけでも直さない",
      "file": "app/js/games/hiyoko.js",
      "old": "if (chicks.every((c) => c.c === chicks[0].c)) {",
      "new": "if (false) {"
    },
    {
      "name": "音当て: なしの問題の乱数を変える",
      "file": "app/js/games/oto.js",
      "old": "mulberry32((seed * 131 + 7) >>> 0)",
      "new": "mulberry32((seed * 131 + 8) >>> 0)"
    },
    {
      "name": "かぶったら0点: なしでも0を1にする",
      "file": "app/js/games/kaburi.js",
      "old": "length === 1 ? v : 0));",
      "new": "length === 1 ? v : 1));"
    },
    {
      "name": "イライラ棒: なしの道の作り直しを変える",
      "file": "app/js/games/iraira.js",
      "old": "export function makeCourses(seed, level) {",
      "new": "export function makeCourses(seed, level) { seed += 1;"
    }
  ]
}
