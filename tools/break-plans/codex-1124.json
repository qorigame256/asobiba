{
  "root": "../..",
  "mode": "copy",
  "copy": [
    "app/js",
    "app/fonts",
    "app/voice",
    "app/sounds",
    "tools/test-logic.mjs",
    "tools/font-chars.json",
    "tools/font-texts.mjs",
    "tools/voice-texts.mjs"
  ],
  "cwd": "copy",
  "env": {
    "QUICK": "1",
    "SEED": "1"
  },
  "build": [
    "node",
    "--input-type=module",
    "-e",
    "await import('./app/js/games/index.js')"
  ],
  "test": [
    "node",
    "tools/test-logic.mjs"
  ],
  "failPattern": "AssertionError \\[ERR_ASSERTION\\]: (.*)",
  "timeoutSec": 300,
  "breaks": [
    {
      "name": "ひよこかぞえ: ひよこが止まる（動いた道のりの検査）",
      "file": "app/js/games/hiyoko.js",
      "old": "  const [px, dx] = bounce(c.x + c.vx * t, r, W - r);\n  const [py] = bounce(c.y + c.vy * t, r, H - r);",
      "new": "  const [px, dx] = bounce(c.x + c.vx * Math.min(t, 1), r, W - r);\n  const [py] = bounce(c.y + c.vy * Math.min(t, 1), r, H - r);"
    },
    {
      "name": "人ごみさがし: 前半・後半の分かれ目がずれる",
      "file": "app/js/games/hitogomi.js",
      "old": "(q < Math.ceil(k / 2) ? 2 : 3)",
      "new": "(q < Math.floor(k / 2) ? 2 : 3)"
    },
    {
      "name": "海戦: ヒット数だけ最初の脱落で終わる",
      "file": "app/js/games/kaisen.js",
      "old": "  if (left.length === 1) t.won = left[0];",
      "new": "  if (left.length === 1 || (t.hitN && outs.length)) t.won = left[0];"
    },
    {
      "name": "見切り: 速さで点の3点に正解の音",
      "file": "app/js/games/mikiri.js",
      "old": "(b.rules?.by === 'speed' ? L.best?.includes(me) : L.gain[me] === 3)",
      "new": "(L.best?.includes(me) || L.gain[me] === 3)"
    },
    {
      "name": "15パズル: CPU が31秒をすぎると人より先にそろえる",
      "file": "app/js/games/slide.js",
      "old": "if (plan.ok && first !== null && t >= Math.max(plan.at, first + plan.lag) && t < lim)",
      "new": "if (plan.ok && (first !== null || t > 31000) && t >= Math.max(plan.at, (first ?? 0) + plan.lag) && t < lim)"
    },
    {
      "name": "15パズル: 人が全員あきらめても予定の時刻まで待つ",
      "file": "app/js/games/slide.js",
      "old": "if ((first === null && humansDone) || (t >= plan.at && !plan.ok))",
      "new": "if (t >= plan.at && (!plan.ok || (first === null && humansDone)))"
    },
    {
      "name": "15パズル: 代打から戻った席をずっと CPU と見る",
      "file": "app/js/games/slide.js",
      "old": "nowT - (seen.get(x) ?? -Infinity) < CPU_SEEN_MS || doneOf(s, x)",
      "new": "seen.has(x) || doneOf(s, x)"
    },
    {
      "name": "イライラ棒: 短い道を作り直さない",
      "file": "app/js/games/iraira.js",
      "old": "    for (let a = 0; a < 300; a++) {",
      "new": "    for (let a = 0; a < 1; a++) {"
    },
    {
      "name": "マルバツ（かぶせる）: 時間切れでかぶせる・動かす手も選ぶ",
      "file": "app/js/games/tictactoe.js",
      "old": "if (put.length) legal = put;",
      "new": "if (put.length && false) legal = put;"
    },
    {
      "name": "15パズル: 古い部分点の知らせを受け付ける",
      "file": "app/js/games/slide.js",
      "old": "!Number.isInteger(m.n) || m.n <= s0.partN[m.p]",
      "new": "!Number.isInteger(m.n) || m.n === s0.partN[m.p]"
    }
  ]
}
